#define ZMK_POINTING_DEFAULT_MOVE_VAL 1200 // 600
#define ZMK_POINTING_DEFAULT_SCRL_VAL 12   // 10

#include <input/processors.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

&mmv_input_listener { input-processors = <&zip_xy_scaler 2 1>; };

&msc_input_listener { input-processors = <&zip_scroll_scaler 2 1>; };

// オートマウスレイヤー自動離脱
&zip_temp_layer {    
    require-prior-idle-ms = <200>;
    excluded-positions = <
        30 // H
        42 // N
        43 // M
        53 // DELETE
        54 // BACKSAPACE
        55 // SPACE
        56 // ENTER
    >;
};

&msc {
    acceleration-exponent = <2>;
    time-to-max-speed-ms = <300>;
    delay-ms = <0>;
};

&mmv {
    time-to-max-speed-ms = <300>;
    acceleration-exponent = <2>;
    trigger-period-ms = <16>;
};

&soft_off { hold-time-ms = <2000>; };

/ {
    // 上下スクロール
    scroll_vertical_encoder: scroll_vertical_encoder {
        compatible = "zmk,behavior-sensor-rotate";
        #sensor-binding-cells = <0>;
        bindings = <&msc SCRL_UP>, <&msc SCRL_DOWN>;
        tap-ms = <0>;
    };

    // 左右スクロール
    scroll_horizontal_encoder: scroll_horizontal_encoder {
        compatible = "zmk,behavior-sensor-rotate";
        #sensor-binding-cells = <0>;
        bindings = <&msc SCRL_LEFT>, <&msc SCRL_RIGHT>;
        tap-ms = <0>;
    };

// オートマウス　クリック用レイヤー
behaviors {
    sl_mouse: sticky_layer_for_mouse {
        compatible = "zmk,behavior-sticky-key";
        #binding-cells = <1>;
        bindings = <&mo>;
        release-after-ms = <200>; // 200msだけクリック用レイヤに移動する（必要に応じて時間を変更）
        quick-release;
        ignore-modifiers;
    };
    lt_mouse_layer: lt_mouse_layer {
        compatible = "zmk,behavior-hold-tap";
        label = "LAYER_TAP_MOUSE";
        bindings = <&mo>, <&mkp>;
        #binding-cells = <2>;
        tapping-term-ms = <200>;
    };
};

macros {
    click_and_exit: click_and_exit {
        label = "CLICK_AND_EXIT";
        compatible = "zmk,behavior-macro";
        #binding-cells = <0>;
        bindings =
            <&macro_press &mkp MB1>
            , <&macro_pause_for_release> // ドラッグ対策に離すまで待つ
            , <&macro_release &mkp MB1>
            , <&macro_tap &to 0> // デフォルトレイヤーに戻る
            , <&macro_tap &sl_mouse 5> // 一瞬だけクリック用レイヤに飛ぶ
            ;
    };
};

    keymap {
        compatible = "zmk,keymap";

        QWERTY {
            bindings = <
&none  &kp N1  &kp N2  &kp N3  &kp N4  &kp N5  &kp N6  &kp N7  &kp N8  &kp N9  &kp N0  &none
&kp TAB       &kp Q            &kp W   &kp E           &kp R             &kp T         &kp Y          &kp U        &kp I      &kp O     &kp P      &kp BSLH
&kp LEFT_WIN  &kp A            &kp S   &kp D           &kp F             &kp G         &kp H          &kp J        &kp K      &kp L     &kp SEMI   &kp SQT
&kp LEFT_ALT  &kp Z            &kp X   &kp C           &kp V             &kp B         &kp N          &kp M        &kp COMMA  &kp DOT   &kp FSLH   &kp EQUAL
&kp ESC       &kp PAUSE_BREAK  &mo 4   &kp LEFT_SHIFT  &kp LEFT_CONTROL  &lt 3 DELETE  &kp BACKSPACE  &lt 1 SPACE  &kp ENTER  &kp LBKT  &kp RBKT   &kp MINUS
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp C_BRI_UP C_BRI_DN>;
        };

        TENKEY_layers {
            bindings = <
&kp F1  &kp F2  &kp F3  &kp F4  &kp F5  &kp F6  &kp F7  &kp F8  &kp F9  &kp F10  &kp F11  &kp F12
&trans  &kp N1  &kp N2  &kp N3  &kp N4  &kp N5  &kp N6  &kp N7  &kp N8  &kp N9   &kp N0   &trans      
&trans  &trans  &trans  &trans  &trans  &kp LA(LS(TAB))  &kp LC(LS(TAB))  &kp UP_ARROW    &kp LC(TAB)      &kp EQUAL  &kp MINUS  &trans
&trans  &trans  &trans  &trans  &trans  &kp LA(TAB)      &kp LEFT_ARROW   &kp DOWN_ARROW  &kp RIGHT_ARROW  &trans     &trans     &trans
&trans  &trans  &trans  &trans  &trans  &trans           &trans           &trans          &trans           &kp LPAR   &kp RPAR   &trans
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp LA(LS(TAB)) LA(TAB)>;
        };

        MOUSE_layers {
            label = "MOUSE";
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans        &trans           &trans    &trans    &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans        &trans           &trans    &trans    &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans        &mkp MB5         &trans    &trans    &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans        &mkp MB4         &lt 3 M   &trans    &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &lt 3 DELETE  &click_and_exit  &mkp MB2  &mkp MB3  &trans  &trans  &trans
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp C_BRI_UP C_BRI_DN>;
        };

        scroll-layers {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN  &inc_dec_kp C_BRI_UP C_BRI_DN>;
        };

        blutooth-layers {
            bindings = <
&bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &bt BT_SEL 5  &trans  &trans  &bt BT_CLR_ALL  &bt BT_CLR  &bt BT_PRV  &bt BT_NXT
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
            sensor-bindings =  <&scroll_vertical_encoder &scroll_horizontal_encoder>;
        };

        doubleclick_layers {
            label = "MOUSE3";
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans        &trans           &trans    &trans    &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans        &trans           &trans    &trans    &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans        &trans           &trans    &trans    &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans        &trans           &lt 3 M   &trans    &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &lt 3 DELETE  &click_and_exit  &mkp MB3  &mkp MB2  &trans  &trans  &trans
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp C_BRI_UP C_BRI_DN>;
        };
    };
};
